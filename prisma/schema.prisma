// MIRROR SCHEMA — client generation only.
//
// The Cardwish database's migration history is owned by the cardwish-crawler
// repo. This file mirrors just the models this service touches so `prisma
// generate` works here. NEVER run `prisma migrate` from this repo: schema
// changes go into cardwish-crawler (prisma/schema.prisma + a migration),
// then get copied here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Card {
  id         String   @id @default(uuid())
  game       String
  setName    String?  @map("set_name")
  setCode    String?  @map("set_code")
  setSlug    String?  @map("set_slug")
  cardNumber String?  @map("card_number")
  name       String
  slug       String?
  language   String?
  imageUrl   String?  @map("image_url")
  // CDN image columns hold object KEYS relative to the CDN root, never
  // absolute URLs — the bucket/CNAME will move.
  sourceId     String?  @map("source_id")
  expansionId   String?  @map("expansion_id")
  rarity        String?
  imageSmallKey String?  @map("image_small_key")
  imageLargeKey String?  @map("image_large_key")
  payload       Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  expansion   Expansion?       @relation(fields: [expansionId], references: [id])
  variantTags CardVariantTag[]

  @@unique([game, language, setSlug, slug])
  @@unique([game, sourceId])
  @@index([expansionId])
  @@map("cards")
}

model Expansion {
  id           String    @id @default(uuid())
  game         String
  sourceId    String    @map("source_id")
  name         String
  code         String?
  series       String?
  /** Every distinct card, including secret rares numbered past the printed size. */
  totalCardCount    Int? @map("total_card_count")
  /** The set size printed on the cards — the denominator in "215/203". */
  numberedCardCount Int? @map("numbered_card_count")
  language     String?
  languageCode String?   @map("language_code")
  releaseDate  DateTime? @map("release_date")
  isOnlineOnly Boolean   @default(false) @map("is_online_only")
  logoKey      String?   @map("logo_key")
  symbolKey    String?   @map("symbol_key")
  cardsSyncedAt   DateTime? @map("cards_synced_at")
  syncedCardCount Int       @default(0) @map("synced_card_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  cards Card[]

  @@unique([game, sourceId])
  @@index([game, releaseDate])
  @@map("expansions")
}

model VariantTag {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  kind      String   @default("other")
  createdAt DateTime @default(now()) @map("created_at")

  cards CardVariantTag[]

  @@map("variant_tags")
}

model CardVariantTag {
  cardId       String @map("card_id")
  variantTagId String @map("variant_tag_id")

  card       Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  variantTag VariantTag @relation(fields: [variantTagId], references: [id], onDelete: Cascade)

  @@id([cardId, variantTagId])
  @@index([variantTagId])
  @@map("card_variant_tags")
}

model IngestionRun {
  id           String    @id @default(uuid())
  marketplace  String
  jobType      String    @map("job_type")
  startedAt    DateTime  @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  status       String
  itemsSeen    Int       @default(0) @map("items_seen")
  itemsCreated Int       @default(0) @map("items_created")
  itemsUpdated Int       @default(0) @map("items_updated")
  itemsFailed  Int       @default(0) @map("items_failed")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("ingestion_runs")
}
