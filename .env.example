# Shared Cardwish Postgres (same database as cardwish-crawler).
DATABASE_URL=postgresql://user:pass@host:port/db?sslmode=require

# Scrydex API (https://scrydex.com/docs) — both headers are required.
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=
# Comma-separated Scrydex game slugs to sync.
SCRYDEX_GAMES=pokemon,lorcana,magic,gundam,onepiece,riftbound
# Abort sync when remaining credits fall below this (overage auto-bills).
SCRYDEX_MIN_CREDITS=500

# DO Spaces (S3-compatible) CDN bucket. Only object KEYS are stored in the DB —
# the public base URL will change (own CNAME later).
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=cardwish-cdn
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

# Parallel image uploads during the mirror pass.
IMAGE_CONCURRENCY=8
